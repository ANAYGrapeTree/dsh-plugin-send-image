  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANAYGrapeTree/dsh-plugin-send-image.git"
  },
  "homepage": "https://github.com/ANAYGrapeTree/dsh-plugin-send-image#readme",
  "bugs": {
    "url": "https://github.com/ANAYGrapeTree/dsh-plugin-send-image/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "image",
    "attachment",
    "cordis"
  ],
  "dsh": {
