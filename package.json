{
  "name": "@dsh-user/send-image",
  "version": "0.1.0",
  "private": true,
  "description": "Let the DSH assistant send images to the user in chat, rendered as clickable picture cards (click to enlarge).",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANAYGrapeTree/dsh-plugin-send-image.git"
  },
  "homepage": "https://github.com/ANAYGrapeTree/dsh-plugin-send-image#readme",
  "bugs": {
    "url": "https://github.com/ANAYGrapeTree/dsh-plugin-send-image/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "image",
    "attachment",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
